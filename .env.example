COUNTRY=sg
BASE_URL=https://api-qa.ninjavan.co
API_TIMEOUT_MS=30000

# Shared operator OAuth (works for all countries — do not put in country configs)
OPERATOR_CLIENT_ID=
OPERATOR_CLIENT_SECRET=
OPERATOR_LOGIN_COUNTRY=sg

# Shipper OAuth is per-country. Prefer config/countries/<country>.local.env
# (gitignored). You can also set these here for a single-country local run:
# SHIPPER_CLIENT_ID=
# SHIPPER_CLIENT_SECRET=
