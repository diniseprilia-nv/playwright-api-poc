#!/usr/bin/env python3
"""Simple scenario runner.

Examples:
    ./run create_route_today --sg
    ./run create_order_success --sg
    ./run create_order_success --sg --number-of-order 3
    ./run --sg
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

SUPPORTED_COUNTRIES = ("sg", "my", "id")
PROJECT_ROOT = Path(__file__).resolve().parent
FEATURE_TARGETS = {
    "create_route": "tests/route/steps/test_create_route.py",
    "archive_route": "tests/route/steps/test_archive_route.py",
    "create_order": "tests/order/steps/test_create_order.py",
}
DEFAULT_TARGETS = list(FEATURE_TARGETS.values())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="run",
        description="Run Gherkin scenarios by tag and country.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  ./run create_route_today --sg\n"
            "  ./run create_order_success --sg\n"
            "  ./run create_order_success --sg --number-of-order 3\n"
            "  ./run --id\n"
        ),
    )
    parser.add_argument(
        "scenario",
        nargs="?",
        default=None,
        help=(
            "Scenario tag (e.g. create_order_success) or feature name "
            f"({', '.join(FEATURE_TARGETS)})"
        ),
    )
    parser.add_argument(
        "--number-of-order",
        type=int,
        default=None,
        help="Override number_of_order for create-order scenarios",
    )

    country = parser.add_mutually_exclusive_group()
    for code in SUPPORTED_COUNTRIES:
        country.add_argument(
            f"--{code}",
            dest="country",
            action="store_const",
            const=code,
            help=f"Use {code.upper()} country config",
        )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args, extra = parser.parse_known_args(argv)

    country = args.country or "sg"
    scenario = args.scenario.lstrip("@") if args.scenario else None
    targets = DEFAULT_TARGETS
    scenario_tag = scenario

    if scenario in FEATURE_TARGETS:
        targets = [FEATURE_TARGETS[scenario]]
        scenario_tag = None

    cmd = [
        sys.executable,
        "-m",
        "pytest",
        *targets,
        f"--country={country}",
    ]
    if scenario_tag:
        cmd.append(f"--scenario={scenario_tag}")
    if args.number_of_order is not None:
        cmd.append(f"--number-of-order={args.number_of_order}")

    if extra and extra[0] == "--":
        extra = extra[1:]
    cmd.extend(extra)

    print(f"→ {' '.join(cmd)}")
    return subprocess.call(cmd, cwd=PROJECT_ROOT)


if __name__ == "__main__":
    raise SystemExit(main())
